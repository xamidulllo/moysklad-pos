# Endi bitta global MoySklad tokeni SHART EMAS — har bir kassir ilova ochilgandagi
# login ekranida o'zining shaxsiy MoySklad login/parolini kiritadi, backend buni
# avtomatik tokenga almashtiradi (POST /security/token) va sessiya sifatida saqlaydi.

# Kassir sessiyasi necha soat amal qiladi (standart: 12 soat)
SESSION_TTL_HOURS=12

# Ilovani HTTPS ostida (production) ishga tushirsangiz — true qiling, shunda
# sessiya cookie'si faqat shifrlangan ulanish orqali yuboriladi.
SESSION_COOKIE_SECURE=false

# Telegram bot orqali "Kassani ochish" tugmasini ko'rsatish uchun (ixtiyoriy —
# bo'lmasa, ilova oddiy veb-sahifa sifatida ishlayveradi, bot shunchaki ishga
# tushmaydi). Token @BotFather'dan olinadi.
BOT_TOKEN=

# Ilovaning tashqi (HTTPS) manzili — bot shu manzilga Web App tugmasini ochadi.
# Render'da bu SHART EMAS (avtomatik RENDER_EXTERNAL_URL orqali aniqlanadi).
# Boshqa hostingda qo'lda kiriting, masalan: https://pos.example.com
PUBLIC_BASE_URL=
