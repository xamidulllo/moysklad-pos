# Endi bitta global MoySklad tokeni SHART EMAS — har bir kassir ilova ochilgandagi
# login ekranida o'zining shaxsiy MoySklad login/parolini kiritadi, backend buni
# avtomatik tokenga almashtiradi (POST /security/token) va sessiya sifatida saqlaydi.

# Kassir sessiyasi necha soat amal qiladi (standart: 12 soat)
SESSION_TTL_HOURS=12

# Ilovani HTTPS ostida (production) ishga tushirsangiz — true qiling, shunda
# sessiya cookie'si faqat shifrlangan ulanish orqali yuboriladi.
SESSION_COOKIE_SECURE=false

# Telegram bot orqali "Kassani ochish" tugmasini ko'rsatish uchun (ixtiyoriy —
# bo'lmasa, ilova oddiy veb-sahifa sifatida ishlayveradi, bot shunchaki ishga
# tushmaydi). Token @BotFather'dan olinadi.
BOT_TOKEN=

# Ilovaning tashqi (HTTPS) manzili — bot shu manzilga Web App tugmasini ochadi.
# Render'da bu SHART EMAS (avtomatik RENDER_EXTERNAL_URL orqali aniqlanadi).
# Boshqa hostingda qo'lda kiriting, masalan: https://pos.example.com
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Google Sheets orqali buyurtmalarni navbatga qo'yish va davriy MoySklad
# sinxronlash (IXTIYORIY — quyidagilar bo'sh qoldirilsa, checkout hozirgidek
# darhol MoySklad'ga yozadi). To'liq sozlash bo'yicha README.md'ga qarang.
# ---------------------------------------------------------------------------

# "direct" (standart) yoki "queue". "queue" faqat quyida ko'rsatilgan
# EXPECTED_MS_ORGANIZATION_ID'ga mos hisob uchun ishlaydi.
CHECKOUT_MODE=direct

# Navbatga qo'yish qaysi MoySklad tashkiloti uchun ishlashi kerak
# (entity/organization href'idagi UUID).
EXPECTED_MS_ORGANIZATION_ID=

# Sinxronlash vazifasi MoySklad'ga navbatdagi buyurtmalarni yuborish uchun
# ishlatadigan login/parol — odatda barcha kassirlar ishlatadigan umumiy hisob.
MS_SYNC_LOGIN=
MS_SYNC_PASSWORD=

# Google Apps Script trigger shu qiymatni "X-Sync-Secret" header'ida
# yuborishi kerak. Yaratish: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_TRIGGER_SECRET=

# Google Sheets'ga ulanish — IKKI usuldan BIRINI to'ldiring:
#
# 1) OAuth (tavsiya — ko'p Google Cloud loyihalarida "Secure by Default"
#    siyosati service-account kalit yaratishni butunlay bloklab qo'yadi).
#    Olish: Cloud Console'da OAuth client ID (Desktop app turi) yaratib, bir
#    martalik login orqali refresh_token olinadi (README.md'ga qarang).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
#
# 2) Service-account JSON kalitining base64 shakli (bir qatorda) — agar
#    "Organization Policy" kalit yaratishga ruxsat bersa.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Orders
